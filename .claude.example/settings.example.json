{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {},
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "deny": [
      "Agent(claude)",
      "Agent(general-purpose)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(chmod *)",
      "Bash(chown *)"
    ],
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable"
  },
  "enabledMcpjsonServers": [],
  "respectGitignore": true,
  "autoUpdatesChannel": "stable"
}