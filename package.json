{
  "name": "@negikirin/repo-pattern",
  "version": "1.2.3",
  "description": "Minimal ECC-first Claude Code project setup and migrator",
  "type": "module",
  "bin": {
    "repo-pattern": "bin/repo-pattern.mjs"
  },
  "scripts": {
    "audit": "node bin/repo-pattern.mjs audit --target .",
    "doctor": "node bin/repo-pattern.mjs doctor --target .",
    "mcp:core": "node bin/repo-pattern.mjs mcp --target . --mcp context7 --mcp tavily --mcp gitnexus",
    "test": "node --test --test-concurrency=1 test/cli/cli-contract.test.mjs scripts/phase-1-characterization.test.mjs test/setup/setup-contract.test.mjs test/ecc/ecc-contract.test.mjs test/gstack/gstack-contract.test.mjs test/ui/ui-contract.test.mjs test/shared/shared-contract.test.mjs test/setup/mcp-attribution-contract.test.mjs && node scripts/self-check.mjs",
    "test:coverage": "node scripts/test-coverage.mjs",
    "check:module-limits": "node scripts/check-module-limits.mjs",
    "measure:test-duration": "node scripts/measure-test-duration.mjs",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run pack:dry",
    "check:diff-coverage": "node scripts/test-coverage.mjs"
  },
  "license": "MIT",
  "author": "NegiKirin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NegiKirin/repo-pattern.git"
  },
  "bugs": {
    "url": "https://github.com/NegiKirin/repo-pattern/issues"
  },
  "homepage": "https://github.com/NegiKirin/repo-pattern#readme",
  "keywords": [
    "repo-pattern",
    "claude-code",
    "everything-claude-code",
    "ecc",
    "ecc-first",
    "mcp",
    "mcp-server",
    "agentic-engineering",
    "ai-engineering",
    "developer-tools",
    "project-template",
    "project-scaffold",
    "setup",
    "migrator",
    "automation",
    "nodejs",
    "javascript"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/repo-pattern.mjs",
    "src/",
    ".claude.example/CLAUDE.md",
    ".claude.example/settings.example.json",
    ".claude.example/settings.local.example.json",
    ".claude.example/hooks/remove-generated-attribution.mjs",
    "docs/gstack-managed-documents.md",
    "docs/repo-pattern/setup-guide.md",
    "mcp/servers/",
    ".repo-pattern.example.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ink": "^6.2.0",
    "ink-big-text": "^2.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "ink-testing-library": "^4.0.0"
  }
}
