{
  "name": "@negikirin/repo-pattern",
  "version": "0.2.3",
  "description": "Minimal ECC-first Claude Code project setup and migrator",
  "type": "module",
  "bin": {
    "repo-pattern": "scripts/repo-pattern.mjs"
  },
  "scripts": {
    "audit": "node scripts/repo-pattern.mjs audit --target .",
    "doctor": "node scripts/repo-pattern.mjs doctor --target .",
    "mcp:web": "node scripts/repo-pattern.mjs mcp --target . --profile web",
    "test": "node scripts/self-check.mjs",
    "test:coverage": "node scripts/test-coverage.mjs",
    "check:module-limits": "node scripts/check-module-limits.mjs",
    "measure:test-duration": "node scripts/measure-test-duration.mjs",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run pack:dry"
  },
  "license": "MIT",
  "author": "NegiKirin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NegiKirin/repo-pattern.git"
  },
  "bugs": {
    "url": "https://github.com/NegiKirin/repo-pattern/issues"
  },
  "homepage": "https://github.com/NegiKirin/repo-pattern#readme",
  "keywords": [
    "repo-pattern",
    "claude-code",
    "everything-claude-code",
    "ecc",
    "ecc-first",
    "mcp",
    "mcp-server",
    "mcp-profiles",
    "agentic-engineering",
    "ai-engineering",
    "developer-tools",
    "project-template",
    "project-scaffold",
    "setup",
    "migrator",
    "automation",
    "nodejs",
    "javascript"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "scripts/",
    ".claude.example/CLAUDE.md",
    ".claude.example/settings.example.json",
    ".claude.example/settings.local.example.json",
    "docs/",
    "mcp/",
    ".repo-pattern.example.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    ".github/workflows/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0"
  }
}
